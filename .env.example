# Copy to .env.local and fill in before running or deploying the site.

# Canonical site URL used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://aviatorsregiment.com

# WhatsApp number that receives enquiries and UPI payment screenshots.
# Digits only, including the country code, e.g. 919876543210.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Community invite links (homepage, footer, About and Community pages).
# Without the WhatsApp link, "Join" opens a chat instead; without the Telegram
# link, the Telegram button is hidden.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# UPI details shown on the booking payment step.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME="Aviator's Regiment"
# QR code image: a path under /public (e.g. /images/upi-qr.png) or an absolute URL.
NEXT_PUBLIC_UPI_QR_IMAGE=

# Server only. Required before live bookings are accepted.
DATABASE_URL=
